# Pro Flow owns its canonical evidence under the private career-data directory.
# Add AI credentials only to .env.local; never commit real secret values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_SUPPORT_MODEL=gpt-5.6-terra
OPENAI_INSIGHTS_MODEL=gpt-5.6-terra
OPENAI_MONTHLY_BUDGET_USD=25
OPENAI_REQUEST_TIMEOUT_MS=120000
PRO_FLOW_PROJECT_ROOT=

# Optional absolute paths when document tools are installed but absent from PATH.
PRO_FLOW_LUALATEX_PATH=
PRO_FLOW_XELATEX_PATH=
PRO_FLOW_PDFINFO_PATH=
PRO_FLOW_PDFTOTEXT_PATH=
PRO_FLOW_CHROME_PATH=
