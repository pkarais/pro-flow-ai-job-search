# Copy this file to .env before running Docker Compose.
# Leave the API key empty to use deterministic offline writing fallbacks.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_SUPPORT_MODEL=gpt-5.6-terra
OPENAI_INSIGHTS_MODEL=gpt-5.6-terra
OPENAI_MONTHLY_BUDGET_USD=25
OPENAI_REQUEST_TIMEOUT_MS=120000
